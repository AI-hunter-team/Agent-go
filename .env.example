# Copy to .env and fill in. .env is git-ignored.
ANTHROPIC_API_KEY=
AGENT_MODEL=claude-opus-5-5
# Hard cap on one decision's output (thinking + tool call), per plan v1.1
DECISION_MAX_TOKENS=1024
# "default" enables server-side refusal fallback; "off" disables it (for model comparisons)
AGENT_FALLBACK=default
PORT=8787

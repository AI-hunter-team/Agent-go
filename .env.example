# Copy to .env and fill in. .env is git-ignored.
# Responses API (DeepSeek by default; credentials are server-only)
# Review/draft: use the user model bound at game start when present;
# otherwise use this developer-configured server default. No extra browser binding.
AGENT_PROVIDER=responses
OPENAI_BASE_URL=https://api.deepseek.com
OPENAI_API_KEY=
AGENT_MODEL=deepseek-flash
# Responses streaming (HTTP SSE); set 0 for JSON-only gateways
OPENAI_STREAM=1
# none / low / high / max; page configurations use their selected setting
OPENAI_REASONING_EFFORT=none
# Total output per request: reasoning + text + tool arguments
# DECISION_THINKING_TOKENS and AGENT_FALLBACK are retired
DECISION_MAX_TOKENS=4096
# Agent, Boss and NPC share the model bound when the session is created.
PORT=8787
# 服务端脱敏 JSONL 调试日志，已被 Git 忽略。
DEBUG_LOG_ENABLED=1
DEBUG_LOG_DIR=logs

# Copy to .env and fill in. .env is git-ignored.
# OpenAI-compatible API (credentials are server-only)
AGENT_PROVIDER=openai
OPENAI_BASE_URL=https://lax.toklens.ai/v1
OPENAI_API_KEY=
AGENT_MODEL=gpt-6-luna
# For Anthropic: AGENT_PROVIDER=anthropic, AGENT_MODEL=claude-opus-5-5
# ANTHROPIC_API_KEY=
# Reasoning allowance only (<=1024); checked against usage, not a provider-side hard cap
DECISION_THINKING_TOKENS=1024
# Separate total completion safety limit; tools/text have their own room
DECISION_MAX_TOKENS=4096
# "default" enables server-side refusal fallback; "off" disables it (for model comparisons)
AGENT_FALLBACK=off
PORT=8787

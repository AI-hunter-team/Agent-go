# 复制为 .env 后填写两个 API Key；.env 已被 Git 忽略。
# 修改后重启服务。provider 表示接口协议，不代表模型厂商。

# Agent：DeepSeek，使用 Anthropic 兼容接口。
# 这是服务端默认配置；页面启用的用户自定义 Agent 配置优先。
AGENT_PROVIDER=anthropic
AGENT_MODEL=deepseek-flash
ANTHROPIC_BASE_URL=https://api.deepseek.com/anthropic
ANTHROPIC_API_KEY=
AGENT_FALLBACK=off
# 用户自定义 OpenAI 兼容接口的流式及推理设置（NPC 独立使用非流式请求）。
OPENAI_STREAM=1
# OPENAI_REASONING_EFFORT=low

# NPC：Kimi，使用 OpenAI 兼容接口，由开发者统一配置。
# 与 Agent 的模型、接口和密钥独立，不受页面自定义配置影响。
# 必须填写 NPC_MODEL 和 NPC_OPENAI_API_KEY；缺失时不会回退到 Agent。
NPC_PROVIDER=openai
# 以当前验收账号可用型号为例；其他账号请以 /v1/models 返回的列表为准。
NPC_MODEL=kimi-k2.6
NPC_OPENAI_BASE_URL=https://api.moonshot.cn/v1
NPC_OPENAI_API_KEY=

# Agent 思考预算（<=1024），按返回用量检查，不是供应商侧硬上限。
DECISION_THINKING_TOKENS=1024
# Agent 总输出保护上限，工具参数与文字另留空间。
DECISION_MAX_TOKENS=4096

PORT=8787
# 服务端脱敏 JSONL 调试日志，已被 Git 忽略。
DEBUG_LOG_ENABLED=1
DEBUG_LOG_DIR=logs
